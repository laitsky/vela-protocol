{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node", "bun"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["migrations/**/*.ts", "ts-tests/**/*.ts"]
}
