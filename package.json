{
  "name": "vela-protocol",
  "private": true,
  "packageManager": "bun@1.3.11",
  "license": "Apache-2.0",
  "scripts": {
    "test": "bun test",
    "test:ts": "bun test ts-tests",
    "typecheck": "bunx tsc --noEmit",
    "program-ids:sync": "bun run scripts/sync-program-ids.ts",
    "program-ids:check": "bun run scripts/check-program-ids.ts",
    "keys:backup:devnet": "bash scripts/backup-program-keys.sh",
    "keys:prepare": "bash scripts/prepare-program-keys.sh",
    "build:local": "bash scripts/build-local.sh",
    "build:devnet-safe": "bash scripts/build-devnet-safe.sh",
    "build:programs": "bash scripts/build-devnet-safe.sh",
    "compat:quick": "bash scripts/verify-rollout.sh",
    "ci:protocol": "bun run build:programs && cargo test -p vela-protocol -- --nocapture && bun test ts-tests/",
    "deploy:devnet": "bash scripts/upgrade-devnet-safe.sh",
    "upgrade:devnet": "bash scripts/upgrade-devnet-safe.sh",
    "arcium:comp-defs:devnet": "bun run scripts/init-arcium-comp-defs-devnet.ts",
    "verify:deployed": "bash scripts/assert-deployed-hash.sh",
    "verify:sbf": "bash scripts/verify-sbf-build-logs.sh",
    "verify:rollout": "bash scripts/verify-rollout.sh",
    "guard:deploy": "bash scripts/guard-anchor-deploy.sh"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2"
  },
  "devDependencies": {
    "@arcium-hq/client": "0.11.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.5.0",
    "anchor-litesvm": "0.2.1",
    "litesvm": "0.6.0",
    "typescript": "^5.8"
  }
}
